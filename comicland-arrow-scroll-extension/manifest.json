{
  "manifest_version": 3,
  "name": "ComicLand Arrow Auto Scroll",
  "version": "1.3.0",
  "description": "Arrow-key scrolling plus per-chapter Auto Scroll for ComicLand, with an on-page control and click-to-stop.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "ComicLand Arrow Scroll",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://comicland.org/comic/*/chapter/*",
        "https://www.comicland.org/comic/*/chapter/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}