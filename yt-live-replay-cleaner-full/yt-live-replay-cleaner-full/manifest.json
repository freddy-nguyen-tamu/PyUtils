{
  "manifest_version": 3,
  "name": "YouTube Live Replay Cleaner",
  "version": "1.2.0",
  "description": "Removes YouTube replay live chat panels, empty shells, black panel leftovers, and Top Fans/leaderboard UI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
