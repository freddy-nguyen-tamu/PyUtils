{
  "manifest_version": 3,
  "name": "Facebook Photo Loop Saver - Firefox",
  "version": "1.1.0",
  "description": "Save Facebook photos one-by-one, verify each download completes before advancing, and skip completed FBIDs from previous runs.",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "action": {
    "default_title": "Facebook Photo Saver — click to start/stop"
  },
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "facebook-photo-loop-saver@local.extension",
      "strict_min_version": "109.0"
    }
  }
}
