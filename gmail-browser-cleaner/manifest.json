{
  "manifest_version": 3,
  "name": "Gmail Keep & Clean — Browser Mode",
  "description": "Keep whole Gmail conversations by custom email/search rules, then move other conversations to Trash using the open Gmail website. No OAuth or API setup.",
  "version": "2.0.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "action": {
    "default_title": "Open Gmail Keep & Clean"
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["rules.js", "gmail-dom.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
