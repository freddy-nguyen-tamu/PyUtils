{
  "manifest_version": 3,
  "name": "Facebook Saved Videos Scraper",
  "version": "1.0",
  "description": "Auto-scroll and scrape all video URLs from Facebook Saved page.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrape Facebook Saved Videos"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/saved/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}