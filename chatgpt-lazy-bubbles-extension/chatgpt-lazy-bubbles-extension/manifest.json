{
  "manifest_version": 3,
  "name": "ChatGPT Lazy Bubbles",
  "version": "1.0.0",
  "description": "Reduces ChatGPT conversation lag by virtualizing far-away message bubbles while preserving scroll position.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Lazy Bubbles",
    "default_popup": "popup.html"
  }
}
